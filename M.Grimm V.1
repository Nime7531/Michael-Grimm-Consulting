{"@context":"https://schema.org","@type":"ProfessionalService","name":"M.Grimm Consult",
"description":"Konstruktion, Projektleitung und Lieferantenauswahl für Architektur, Kunst, Maschinenbau, Anlagenbau und Röntgentechnologie.",
"founder":{"@type":"Person","name":"Michael Grimm","jobTitle":"Diplom-Ingenieur Maschinenbau"},
"areaServed":"DE","availableLanguage":["de"],
"address":{"@type":"PostalAddress","streetAddress":"Hohlstraße 11","postalCode":"61250","addressLocality":"Usingen","addressCountry":"DE"},
"email":"kontakt@mgrimm-consult.de","telephone":"+49 171 6155922","url":"https://mgrimm-consult.de"}
</script>

<script>
(function(){
"use strict";
var root=document.documentElement,
    reduce=matchMedia("(prefers-reduced-motion: reduce)").matches,
    hasIO="IntersectionObserver" in window,
    canHover=matchMedia("(hover: hover)").matches;
if(!reduce && hasIO) root.classList.add("js");

var header=document.querySelector(".site-header"),
    hero=document.querySelector(".hero"),
    steps=document.querySelector(".steps"),
    themeMeta=document.querySelector("meta[name=theme-color]");

function clamp(v,a,b){return v<a?a:(v>b?b:v);}

/* 1  Scroll-Handler */
var ticking=false, pItems=[], parallaxOn=false;
function schedule(){ if(!ticking){ ticking=true; requestAnimationFrame(frame); } }
function frame(){
  ticking=false;
  var y=window.pageYOffset||root.scrollTop||0,
      max=Math.max(1, root.scrollHeight-window.innerHeight);
  if(header) header.style.setProperty("--p", Math.min(1,y/max).toFixed(4));
  var heroH=hero?hero.offsetHeight:0,
      past=y > heroH-(header?header.offsetHeight:0);
  root.classList.toggle("past-hero", past);
  if(themeMeta){
    var c=past?(getComputedStyle(root).getPropertyValue("--bg").trim()||"#ffffff"):"#2a2829";
    if(themeMeta.getAttribute("content")!==c) themeMeta.setAttribute("content",c);
  }
  if(!reduce && hero) root.style.setProperty("--sy", Math.min(y,heroH));
  stepsProgress(); parallax();
}

/* 2  Schritte-Linie */
function stepsProgress(){
  if(!steps) return;
  var r=steps.getBoundingClientRect(), vh=window.innerHeight,
      p=(vh*0.85-r.top)/(r.height+vh*0.1);
  steps.style.setProperty("--sp", clamp(p,0,1).toFixed(3));
}

/* 3  Parallax */
function buildParallax(){
  pItems=[];
  var portrait=document.querySelector(".portrait");
  if(portrait) pItems.push({el:portrait,f:0.06,ty:0});
  Array.prototype.forEach.call(document.querySelectorAll(".project"),function(el,i){
    pItems.push({el:el,f:(i%2===0?0.05:-0.035),ty:0});
  });
}
function parallax(){
  if(reduce) return;
  if(window.innerWidth<=680){
    if(parallaxOn){ pItems.forEach(function(it){ it.ty=0; it.el.style.removeProperty("--ty"); }); parallaxOn=false; }
    return;
  }
  parallaxOn=true;
  var vh=window.innerHeight;
  pItems.forEach(function(it){
    var r=it.el.getBoundingClientRect();
    if(r.bottom<-200||r.top>vh+200) return;
    var c=r.top-it.ty+r.height/2-vh/2;
    it.ty=clamp(c*it.f,-70,70);
    it.el.style.setProperty("--ty", it.ty.toFixed(1));
  });
}

/* 4  Maus-Glow */
if(!reduce && canHover){
  Array.prototype.forEach.call(document.querySelectorAll(".hero, .glow"),function(el){
    el.addEventListener("pointermove",function(e){
      var r=el.getBoundingClientRect();
      el.style.setProperty("--mx",(e.clientX-r.left)+"px");
      el.style.setProperty("--my",(e.clientY-r.top)+"px");
    },{passive:true});
    el.addEventListener("pointerleave",function(){
      el.style.setProperty("--mx","-999px"); el.style.setProperty("--my","-999px");
    });
  });
}

/* 5  Scroll-Reveal, 6  seen, 7  Count-up */
if(!reduce && hasIO){
  var sel=[".sheet .wrap > .mono",".about-text > p",".portrait",".facts > div",".services li",
           ".project",".steps li",".note","#contact-form",".details",".reflist",
           ".legal-body > *",".foot-grid > *",".foot-legal"].join(",");
  var revealIO=new IntersectionObserver(function(entries,obs){
    entries.forEach(function(en){
      if(!en.isIntersecting) return;
      var el=en.target; el.classList.add("in"); obs.unobserve(el);
      setTimeout(function(){ el.classList.remove("reveal","in"); el.style.removeProperty("--i"); },1400);
    });
  },{rootMargin:"0px 0px -6% 0px",threshold:.1});
  Array.prototype.forEach.call(document.querySelectorAll(sel),function(el){
    if(el.closest && el.closest("#result")) return;
    var parent=el.parentElement, idx=0;
    if(parent){
      idx=Array.prototype.indexOf.call(parent.children,el);
      if(el.classList.contains("project")) idx=idx%2;
    }
    el.classList.add("reveal");
    el.style.setProperty("--i", Math.min(idx,4));
    revealIO.observe(el);
  });

  var seenIO=new IntersectionObserver(function(entries,obs){
    entries.forEach(function(en){
      if(!en.isIntersecting) return;
      var t=en.target.__seenTarget||en.target;
      t.classList.add("seen"); obs.unobserve(en.target);
    });
  },{rootMargin:"0px 0px -10% 0px",threshold:.05});
  Array.prototype.forEach.call(document.querySelectorAll(".project, .services, .facts"),function(el){ seenIO.observe(el); });
  Array.prototype.forEach.call(document.querySelectorAll(".sheet h2"),function(h2){
    var host=h2.parentElement||h2; host.__seenTarget=h2; seenIO.observe(host);
  });

  var facts=document.querySelector(".facts");
  if(facts){
    var countIO=new IntersectionObserver(function(entries,obs){
      entries.forEach(function(en){
        if(!en.isIntersecting) return;
        obs.disconnect();
        Array.prototype.forEach.call(facts.querySelectorAll("[data-count]"),function(el){
          var target=parseInt(el.getAttribute("data-count"),10)||0,
              suffix=el.getAttribute("data-suffix")||"", dur=1300, t0=0;
          el.textContent="0"+suffix;
          requestAnimationFrame(function step(ts){
            if(!t0) t0=ts;
            var k=Math.min(1,(ts-t0)/dur), e=1-Math.pow(1-k,3);
            el.textContent=Math.round(target*e)+suffix;
            if(k<1) requestAnimationFrame(step);
          });
        });
      });
    },{threshold:.4});
    countIO.observe(facts);
  }
}

/* 8  Scroll-Spy */
if(hasIO){
  var navLinks={};
  Array.prototype.forEach.call(document.querySelectorAll(".nav a"),function(a){ navLinks[a.getAttribute("href")]=a; });
  var spyIO=new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(!en.isIntersecting) return;
      var link=navLinks["#"+en.target.id];
      if(!link) return;
      Object.keys(navLinks).forEach(function(k){ navLinks[k].classList.remove("active"); });
      link.classList.add("active");
    });
  },{rootMargin:"-45% 0px -50% 0px"});
  ["ueber","leistungen","portfolio","kontakt"].forEach(function(id){
    var s=document.getElementById(id); if(s) spyIO.observe(s);
  });
}

/* 9  Kopieren */
function copyText(txt,done){
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(function(){done(true);},function(){done(false);});
  } else { done(false); }
}
Array.prototype.forEach.call(document.querySelectorAll(".copy-btn[data-copy]"),function(btn){
  btn.addEventListener("click",function(){
    var el=document.querySelector(btn.getAttribute("data-copy"));
    if(!el) return;
    var old=btn.textContent;
    copyText((el.textContent||"").trim(),function(ok){
      btn.textContent=ok?"Kopiert":"Bitte manuell kopieren";
      setTimeout(function(){ btn.textContent=old; },1800);
    });
  });
});

/* 10  Formular */
var form=document.getElementById("contact-form"),
    errBox=document.getElementById("form-error"),
    result=document.getElementById("result"),
    resText=document.getElementById("result-text"),
    resCopy=document.getElementById("result-copy"),
    resStatus=document.getElementById("result-status");
if(form){
  form.addEventListener("submit",function(e){
    e.preventDefault();
    var name=(form.name && form.name.value||"").trim(),
        mail=(form.email && form.email.value||"").trim(),
        msg=(form.message && form.message.value||"").trim(),
        ok=form.consent && form.consent.checked;
    errBox.textContent="";
    if(!name||!mail||!msg||!ok){
      errBox.textContent="Bitte Name, E-Mail und Nachricht ausfüllen und die Einwilligung bestätigen.";
      return;
    }
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail)){
      errBox.textContent="Bitte prüfen Sie die E-Mail-Adresse.";
      return;
    }
    resText.textContent="Anfrage über mgrimm-consult.de\nVon: "+name+" <"+mail+">\n\n"+msg;
    result.hidden=false;
    result.scrollIntoView({block:"nearest",behavior:"smooth"});
  });
}
if(resCopy){
  resCopy.addEventListener("click",function(){
    copyText(resText.textContent,function(ok){
      resStatus.textContent=ok?"Kopiert":"Bitte manuell kopieren";
      setTimeout(function(){ resStatus.textContent=""; },2500);
    });
  });
}

/* Start */
buildParallax();
addEventListener("scroll",schedule,{passive:true});
addEventListener("resize",function(){ buildParallax(); schedule(); },{passive:true});
schedule();
})();
</script>
</body>
</html>
