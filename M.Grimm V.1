<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>M.Grimm Consult – Konstruktion, Projektleitung und technische Lösungen</title>
<meta name="description" content="M.Grimm Consult, Michael Grimm, Diplom-Ingenieur Maschinenbau: konstruktive Lösungen für Architektur, Design, Maschinen- und Anlagenbau, Projektleitung von der Idee bis zur Montage. Über 37 Jahre Erfahrung, über 500 Projekte.">
<meta name="theme-color" content="#2a2829">
<meta property="og:type" content="website">
<meta property="og:title" content="M.Grimm Consult">
<meta property="og:description" content="Konstruktion, Projektleitung und Lieferantenauswahl für Architektur, Kunst, Maschinen- und Anlagenbau.">
<meta property="og:image" content="assets/hero_blueprint.svg">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23d10000'/%3E%3Cpath d='M7 24V9l5 8 5-8v15' fill='none' stroke='%23fff' stroke-width='3'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
<link rel="preload" as="image" href="assets/hero_blueprint.svg">
<style>

/* ============================================================
   1  GRUNDSYSTEM  (Teil 1, Abschnitt 2-4)
   ============================================================ */
*,*::before,*::after{box-sizing:border-box}

:root{
 --bg:#fff; --surface:#f5f4f4; --fg:#2a2829; --strong:#000; --muted:#6a6667; --line:#dcd9da;
 --accent:#d10000; --accent-dark:#960000; --accent-text:#d10000; --accent-hi:#ff5a5a; --on-accent:#fff;
 --hero-bg:#2a2829; --hero-fg:#fff; --hero-muted:#cbc7c8; --hero-grid:#373435; --hero-line:#5e5a5b; --hero-surface:#322f30;
 --top-bg:var(--hero-bg); --top-fg:var(--hero-fg); --top-muted:var(--hero-muted); --top-line:var(--hero-line);
 --ease:cubic-bezier(.2,.7,.2,1);
 --font-display:"Poppins","Helvetica Neue",Arial,sans-serif; --font-body:var(--font-display); --font-mono:var(--font-display);
 --gl:max(16px,env(safe-area-inset-left,0px)); --gr:max(16px,env(safe-area-inset-right,0px));
 padding-bottom:env(safe-area-inset-bottom,0px);
}
@media(prefers-color-scheme:dark){
 :root:not([data-theme=light]){--bg:#000;--surface:#161415;--fg:#e9e7e7;--strong:#fff;--muted:#a29d9e;--line:#2f2c2d;--accent-text:#ff5a5a;color-scheme:dark}
}
:root[data-theme=dark]{--bg:#000;--surface:#161415;--fg:#e9e7e7;--strong:#fff;--muted:#a29d9e;--line:#2f2c2d;--accent-text:#ff5a5a;color-scheme:dark}

html.past-hero{--top-bg:var(--bg);--top-fg:var(--strong);--top-muted:var(--muted);--top-line:var(--line)}

.dark{--fg:#fff;--strong:#fff;--muted:var(--hero-muted);--line:var(--hero-line);--surface:var(--hero-surface);
 --accent-text:var(--accent-hi);background-color:var(--hero-bg);color:var(--fg)}

html{scroll-behavior:smooth;scroll-padding-top:4.5rem;-webkit-text-size-adjust:100%}
body{margin:0;padding-left:var(--gl);padding-right:var(--gr);overflow-x:hidden;
 background:var(--bg);color:var(--fg);font:400 16px/1.7 var(--font-body);-webkit-font-smoothing:antialiased}

/* Statusleisten-Streifen (iOS) in Headerfarbe */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;
 background:var(--top-bg);transition:background .35s var(--ease)}

h1,h2,h3{margin:0;line-height:1.15;letter-spacing:-.02em;text-wrap:balance}
p{margin:0}
img{max-width:100%}
a{color:inherit}

h1{font-size:clamp(2.3rem,6.2vw,4.7rem);font-weight:700;letter-spacing:-.035em;line-height:1.06;max-width:13ch}

.mono{font:500 .72rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
b,strong{font-weight:600}
.num{font-variant-numeric:tabular-nums}

:focus-visible{outline:2px solid var(--accent-text);outline-offset:3px}
.hero :focus-visible,.dark :focus-visible,.site-header:not(.past) :focus-visible{outline-color:var(--accent-hi)}
html.past-hero .site-header :focus-visible{outline-color:var(--accent-text)}

.skip{position:absolute;left:-9999px;top:0;z-index:60;background:var(--accent);color:#fff;padding:.8rem 1.2rem;
 font:600 .78rem var(--font-body);letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
.skip:focus{left:var(--gl)}

/* Layout */
.wrap{width:100%;max-width:1120px;margin-inline:auto}
.bleed{margin-left:calc(-1 * var(--gl));margin-right:calc(-1 * var(--gr));
 padding-left:var(--gl);padding-right:var(--gr)}

/* ============================================================
   2  HEADER  (Teil 1, Abschnitt 5)
   ============================================================ */
.site-header{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;
 background:var(--top-bg);color:var(--top-fg);border-bottom:1px solid var(--top-line);
 transition:background .35s var(--ease),border-color .35s var(--ease),color .35s var(--ease)}
.site-header .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:4rem}

.brand{display:inline-flex;align-items:center;gap:.7rem;font-weight:700;font-size:1.02rem;text-decoration:none;color:var(--top-fg)}
.brand .mark{position:relative;flex:none;width:1.4rem;height:1.4rem;background:var(--accent);transition:transform .5s ease}
.brand .mark::after{content:"";position:absolute;inset:.32rem;border-left:2px solid #fff;border-bottom:2px solid #fff}
.brand:hover .mark{transform:rotate(90deg)}
.brand .sub{font-weight:500;color:var(--top-muted);transition:color .35s var(--ease)}

.nav{display:flex;align-items:center;gap:1.8rem;margin-left:auto}
.nav a{position:relative;font-size:.9rem;font-weight:500;color:var(--top-muted);text-decoration:none;
 padding-block:.2rem;transition:color .3s var(--ease)}
.nav a::after{content:"";position:absolute;left:0;right:0;bottom:-.15rem;height:2px;background:var(--accent-hi);
 transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease)}
.nav a:hover,.nav a.active{color:var(--top-fg)}
.nav a:hover::after,.nav a.active::after{transform:none}

.lang{display:inline-flex;border:1px solid var(--top-line);margin-left:1.6rem;transition:border-color .35s var(--ease)}
.lang button{font:500 .72rem var(--font-mono);letter-spacing:.1em;padding:.4rem .65rem;cursor:pointer;
 background:transparent;color:var(--top-muted);border:0;transition:background .3s var(--ease),color .3s var(--ease)}
.lang button[aria-pressed=true]{background:var(--top-fg);color:var(--top-bg)}

.progress{position:absolute;left:0;bottom:-1px;width:100%;height:2px;background:var(--accent-hi);
 transform:scaleX(var(--p,0));transform-origin:left}

/* ============================================================
   3  HERO  (Teil 1, Abschnitt 6)
   ============================================================ */
.hero{position:relative;isolation:isolate;overflow-x:clip;
 background-color:var(--hero-bg);color:var(--hero-fg);
 --gpos:-1px calc(-1px + var(--sy,0)*0.12px);
 background-image:linear-gradient(var(--hero-grid) 1px,transparent 1px),
                  linear-gradient(90deg,var(--hero-grid) 1px,transparent 1px);
 background-size:56px 56px;background-position:var(--gpos);
 padding-top:clamp(3rem,7vw,5.5rem);padding-bottom:clamp(3rem,6vw,5rem)}

.hero::before,.glow::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
 background-image:linear-gradient(var(--accent-hi) 1px,transparent 1px),
                  linear-gradient(90deg,var(--accent-hi) 1px,transparent 1px);
 background-size:56px 56px;background-position:var(--gpos);opacity:.55;
 -webkit-mask-image:radial-gradient(220px circle at var(--mx,-999px) var(--my,-999px),#000,transparent 72%);
 mask-image:radial-gradient(220px circle at var(--mx,-999px) var(--my,-999px),#000,transparent 72%)}

.glow{position:relative;isolation:isolate;--gpos:-1px -1px;
 background-image:linear-gradient(var(--hero-grid) 1px,transparent 1px),
                  linear-gradient(90deg,var(--hero-grid) 1px,transparent 1px);
 background-size:56px 56px;background-position:var(--gpos)}
.glow::before{opacity:.4}

.hero-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);
 gap:2.5rem clamp(1.5rem,3vw,3rem);align-items:end}
.hero-text{padding-bottom:clamp(1rem,3vw,2.5rem);min-width:0}

.eyebrow{display:inline-flex;align-items:center;gap:.8rem;color:var(--accent-hi)}
.eyebrow::before{content:"";width:2.2rem;height:1px;background:var(--accent-hi)}
.hero h1{margin-top:1.1rem}
.lead{margin-top:1.6rem;font-size:clamp(1rem,1.7vw,1.12rem);max-width:46ch;color:var(--hero-muted)}
.cta-row{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2.2rem}

@keyframes rise{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.rise{animation:rise 1s var(--ease) both;animation-delay:calc(var(--d,0)*1ms)}

.blueprint{min-width:0;align-self:end}
.plan{display:block;width:100%;height:auto;opacity:var(--po,.8);user-select:none;pointer-events:none;
 -webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 26%,#000 78%,transparent 100%),
                    linear-gradient(to right,transparent 0,#000 20%,#000 76%,transparent 100%);
 -webkit-mask-composite:source-in;
 mask-image:linear-gradient(to bottom,transparent 0,#000 26%,#000 78%,transparent 100%),
            linear-gradient(to right,transparent 0,#000 20%,#000 76%,transparent 100%);
 mask-composite:intersect;
 animation:planin 1.8s var(--ease) .5s both}
@keyframes planin{from{opacity:0;transform:scale(1.05);filter:blur(6px)}to{opacity:var(--po,.8);transform:none;filter:blur(0)}}
@media(min-width:901px){.plan{max-height:360px;width:auto;max-width:100%;margin-left:auto}}
.par{transform:translateY(calc(var(--sy,0)*-0.06px))}

/* Planstempel */
.titleblock{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
 margin-top:clamp(2.5rem,5vw,4rem);border:1px solid var(--hero-line);background:transparent}
.titleblock div{padding:.9rem 1.1rem 1rem;border-left:1px solid var(--hero-line);min-width:0}
.titleblock div:first-child{border-left:0}
.titleblock .mono{color:var(--hero-muted)}
.titleblock b{display:block;font-weight:500;font-size:.93rem;margin-top:.2rem;overflow-wrap:anywhere}

/* ============================================================
   4  BUTTONS  (Teil 1, Abschnitt 7)
   ============================================================ */
.btn{position:relative;isolation:isolate;overflow:hidden;display:inline-flex;align-items:center;
 justify-content:space-between;gap:1.2rem;min-height:3.5rem;padding:0 1.5rem;text-decoration:none;cursor:pointer;
 font:600 .78rem var(--font-body);letter-spacing:.12em;text-transform:uppercase;
 border:1px solid var(--accent);transition:color .4s var(--ease),border-color .4s var(--ease)}
.btn::before{content:"";position:absolute;inset:0;z-index:-1;transform:translateX(-101%);transition:transform .55s var(--ease)}
.btn::after{content:"";flex:none;width:1.5rem;height:.75rem;background:currentColor;
 -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 12'><path d='M0 6h22M17 1l5 5-5 5' fill='none' stroke='black' stroke-width='1.5'/></svg>") center/contain no-repeat;
 mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 12'><path d='M0 6h22M17 1l5 5-5 5' fill='none' stroke='black' stroke-width='1.5'/></svg>") center/contain no-repeat;
 transition:transform .45s var(--ease)}
.btn:hover::before{transform:none}
.btn:hover::after{transform:translateX(6px)}
.btn.primary{background:var(--accent);color:var(--on-accent)}
.btn.primary::before{background:var(--accent-dark)}
.btn.primary:hover{border-color:var(--accent-dark)}
.btn.ghost{background:transparent;color:var(--hero-fg);border-color:var(--hero-muted)}
.btn.ghost::before{background:var(--hero-fg)}
.btn.ghost:hover{color:var(--hero-bg);border-color:var(--hero-fg)}

/* ============================================================
   5  SEKTIONSRASTER  (Teil 2, Abschnitt 8)
   ============================================================ */
section.sheet{padding-block:clamp(4rem,9vw,7.5rem);border-bottom:1px solid var(--line)}
.sheet .wrap{display:grid;grid-template-columns:minmax(0,200px) minmax(0,1fr);gap:2rem clamp(1.5rem,5vw,4rem)}
.sheet .wrap>.mono{position:sticky;top:calc(env(safe-area-inset-top,0px) + 6rem);align-self:start;
 display:inline-flex;align-items:center;gap:.7rem}
.sheet .wrap>.mono::before{content:"";width:1.6rem;height:2px;background:var(--accent-text)}
.sheet h2{font-size:clamp(2rem,4.4vw,3.3rem);font-weight:600;max-width:18ch}
.sheet .body{display:flex;flex-direction:column;gap:3rem;min-width:0}

.js .sheet h2{clip-path:inset(0 0 100% 0);transform:translateY(.45em);
 transition:clip-path 1.1s var(--ease),transform 1.1s var(--ease)}
.js .sheet h2.seen{clip-path:inset(-.25em -.1em -.25em -.1em);transform:none}

.facts,.services{position:relative}
.facts::before,.services::before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:var(--strong);
 transform-origin:left;transition:transform 1.5s var(--ease)}
.js .facts::before,.js .services::before{transform:scaleX(0)}
.js .facts.seen::before,.js .services.seen::before{transform:none}

.note{font-size:.85rem;color:var(--muted)}

/* ============================================================
   6  ÜBER MICH  (Teil 2, Abschnitt 9)
   ============================================================ */
.about-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,300px);gap:2.5rem;align-items:start}
.about-text{display:flex;flex-direction:column;gap:1.2rem;max-width:60ch}
.about-text p:first-child{font-size:1.12rem;color:var(--strong)}
.about-text p+p{color:var(--muted)}

.portrait{position:relative;aspect-ratio:4/5;border:1px solid var(--line);background:var(--surface);
 display:flex;align-items:flex-end;padding:.9rem;translate:0 calc(var(--ty,0)*1px)}
.portrait::before,.portrait::after{content:"";position:absolute;width:1.6rem;height:1.6rem;
 border:2px solid var(--accent-text);pointer-events:none}
.portrait::before{top:-7px;left:-7px;border-right:0;border-bottom:0}
.portrait::after{bottom:-7px;right:-7px;border-left:0;border-top:0}
.portrait svg{position:absolute;inset:0;width:100%;height:100%}
.portrait .mono{position:relative;z-index:1}

.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
.facts>div{padding:1.2rem 1rem 0 0;min-width:0}
.facts b{display:block;font-weight:600;font-size:clamp(2rem,4.4vw,3.1rem);letter-spacing:-.035em;line-height:1.1;
 font-variant-numeric:tabular-nums;color:var(--accent-text)}
.facts span{display:block;font-size:.88rem;color:var(--muted)}

/* ============================================================
   7  LEISTUNGEN  (Teil 2, Abschnitt 10)
   ============================================================ */
.services{list-style:none;margin:0;padding:0}
.services li{position:relative;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr) 2.2rem;
 gap:.4rem 2rem;padding:1.9rem 1.2rem;border-bottom:1px solid var(--line);
 transition:background .5s var(--ease),opacity .5s var(--ease)}
.services li::before{content:"";position:absolute;left:0;right:0;top:-1px;height:2px;background:var(--accent);
 transform:scaleX(0);transform-origin:left;transition:transform .7s var(--ease)}
.services li::after{content:"";align-self:center;justify-self:end;width:1.6rem;height:.8rem;background:var(--accent-text);
 -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 12'><path d='M0 6h22M17 1l5 5-5 5' fill='none' stroke='black' stroke-width='1.5'/></svg>") center/contain no-repeat;
 mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 12'><path d='M0 6h22M17 1l5 5-5 5' fill='none' stroke='black' stroke-width='1.5'/></svg>") center/contain no-repeat;
 opacity:0;transform:translateX(-14px);transition:opacity .4s var(--ease),transform .55s var(--ease)}
.services h3{font-size:1.28rem;letter-spacing:-.015em}
.services p{color:var(--muted);transition:color .4s var(--ease)}
@media(hover:hover){
 .services:hover li:not(:hover){opacity:.5}
 .services li:hover{background:var(--surface)}
 .services li:hover::before{transform:scaleX(1)}
 .services li:hover::after{opacity:1;transform:none}
 .services li:hover p{color:var(--fg)}
}

/* ============================================================
   8  PORTFOLIO  (Teil 2, Abschnitt 11)
   ============================================================ */
.projects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3rem 2rem}
@media(min-width:681px){.projects>.project:nth-child(even){margin-top:3.5rem}}
.project{display:flex;flex-direction:column;gap:.9rem;min-width:0;translate:0 calc(var(--ty,0)*1px)}
.drawing{position:relative;overflow:hidden;aspect-ratio:8/5;background:var(--surface);
 border:1px solid var(--line);color:var(--strong);transition:border-color .3s}
.drawing svg{display:block;width:100%;height:100%;transition:transform .9s var(--ease)}
.drawing::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--accent-hi);
 transform:scaleX(0);transform-origin:left;transition:transform .6s var(--ease)}
.project .meta{display:flex;flex-wrap:wrap;gap:.3rem 1.2rem}
.project h3{font-size:1.28rem;transition:color .3s var(--ease)}
.project p{font-size:.96rem;color:var(--muted)}
@media(hover:hover){
 .project:hover .drawing{border-color:var(--accent-hi)}
 .project:hover .drawing svg{transform:scale(1.06)}
 .project:hover .drawing::after{transform:scaleX(1)}
 .project:hover h3{color:var(--accent-hi)}
}
.js .project .drawing{clip-path:inset(0 100% 0 0);transition:clip-path 1.3s var(--ease) .2s,border-color .3s}
.js .project.seen .drawing{clip-path:inset(0)}

/* ============================================================
   9  ARBEITSWEISE  (Teil 2, Abschnitt 12)
   ============================================================ */
.steps{position:relative;list-style:none;margin:0;padding:0;
 display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);counter-reset:step}
.steps::before{content:"";position:absolute;left:0;right:0;top:-1px;height:3px;background:var(--accent);
 transform-origin:left;transform:scaleX(var(--sp,0))}
.steps li{padding:1.4rem 1.4rem .4rem 0;counter-increment:step;display:flex;flex-direction:column;gap:.55rem}
.steps li::before{content:"Phase " counter(step);font:500 .72rem var(--font-mono);letter-spacing:.1em;
 text-transform:uppercase;color:var(--accent-text)}
html[lang=en] .steps li::before{content:"Stage " counter(step)}
.steps h3{font-size:1.18rem;transition:color .3s}
.steps p{color:var(--muted);font-size:.95rem}
@media(hover:hover){.steps li:hover h3{color:var(--accent-text)}}

/* ============================================================
   10  KONTAKT  (Teil 3, Abschnitt 13)
   ============================================================ */
.contact-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:3rem}
form{display:flex;flex-direction:column;gap:1.4rem;min-width:0}
.field{display:flex;flex-direction:column;gap:.2rem}
.field label{font:500 .72rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);
 transition:color .25s}
.field:focus-within label{color:var(--accent-text)}
input,select,textarea{font:400 1rem var(--font-body);color:var(--fg);background:transparent;border:0;
 border-bottom:1px solid var(--line);border-radius:0;padding:.7rem 0;width:100%;
 transition:border-color .25s,box-shadow .25s}
select option{color:#2a2829;background:#fff}
input:hover,select:hover,textarea:hover{border-bottom-color:var(--muted)}
input:focus,select:focus,textarea:focus{outline:none;border-bottom-color:var(--accent);box-shadow:0 1px 0 0 var(--accent)}
textarea{min-height:8rem;resize:vertical}
.check{display:flex;gap:.7rem;align-items:flex-start;font-size:.9rem;color:var(--muted)}
.check input{width:1.1rem;height:1.1rem;margin-top:.25rem;padding:0;accent-color:var(--accent);flex:none;border-bottom:0}
.check a{color:var(--accent-text)}
.row2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem}
form .btn{align-self:start}
.form-error{font-size:.85rem;color:var(--accent-text)}
.form-error:empty{display:none}

.result{border:1px solid var(--accent);background:var(--surface);padding:1.3rem;
 display:flex;flex-direction:column;gap:.8rem}
.result[hidden]{display:none}
.result h3{font-size:1.15rem}
.result pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:400 .88rem/1.6 var(--font-body);color:var(--muted)}
.result-actions{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}

.details{display:flex;flex-direction:column;gap:1.4rem;margin:0}
.details dt{margin-bottom:.2rem}
.details dd{margin:0;font-size:1.05rem;color:var(--strong);overflow-wrap:anywhere}
.copy-line{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap}
.copy-btn{font:500 .7rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase;padding:.3rem .65rem;
 border:1px solid var(--line);background:transparent;color:var(--muted);cursor:pointer;
 transition:color .25s,border-color .25s,background .25s}
.copy-btn:hover{color:var(--on-accent);background:var(--accent);border-color:var(--accent)}
.status{font:500 .72rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--accent-text)}

/* ============================================================
   11  FOOTER  (Teil 3, Abschnitt 14)
   ============================================================ */
.foot{padding-top:clamp(3.5rem,7vw,5.5rem);padding-bottom:2rem}
.foot-grid{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap}
.foot .brand{color:var(--hero-fg)}
.foot .brand .sub{color:var(--hero-muted)}
.claim{margin-top:1.4rem;font-size:clamp(1.5rem,3.4vw,2.4rem);font-weight:600;letter-spacing:-.025em;
 line-height:1.15;max-width:18ch;text-wrap:balance}
.totop{display:inline-flex;align-items:center;gap:.7rem;text-decoration:none;color:var(--hero-fg);
 border:1px solid var(--hero-line);padding:.8rem 1.2rem;font-weight:500;font-size:.9rem;
 transition:background .3s var(--ease),color .3s var(--ease),border-color .3s var(--ease)}
.totop span{transition:transform .35s var(--ease)}
.totop:hover{background:var(--hero-fg);border-color:var(--hero-fg);color:var(--hero-bg)}
.totop:hover span{transform:translateY(-4px)}
.foot-legal{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.6rem 2rem;margin-top:3rem;
 padding-top:1.2rem;border-top:1px solid var(--hero-line)}
.foot-legal a{color:inherit}

/* Rechtstexte */
.legal h2{max-width:none}
.legal-body{display:flex;flex-direction:column;gap:1rem;max-width:70ch}
.legal-body h3{font-size:1.1rem;margin-top:.8rem}
.legal-body p{color:var(--muted);font-size:.95rem}

/* ============================================================
   12  REVEAL  (Teil 3, Abschnitt 15.5)
   ============================================================ */
.js .reveal{opacity:0;transform:translateY(28px);
 transition:opacity .9s var(--ease),transform .9s var(--ease);transition-delay:calc(var(--i,0)*90ms)}
.js .reveal.in{opacity:1;transform:none}

/* ============================================================
   13  RESPONSIVE  (Teil 3, Abschnitt 17)
   ============================================================ */
@media(max-width:960px){
 .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:900px){
 .hero{position:relative;overflow:hidden}
 .hero-grid{grid-template-columns:minmax(0,1fr)}
 .hero-text{padding-bottom:0}
 .blueprint{position:absolute;top:7rem;left:0;right:0;z-index:-1;pointer-events:none;--po:.3}
 .plan{width:125%;margin-left:-2%}
 .par{transform:none}
}
@media(max-width:860px){
 .sheet .wrap{grid-template-columns:minmax(0,1fr);gap:1.2rem}
 .sheet .wrap>.mono{position:static}
 .about-grid{grid-template-columns:minmax(0,1fr)}
 .portrait{max-width:260px}
 .contact-grid{grid-template-columns:minmax(0,1fr)}
}
@media(max-width:760px){
 .nav{display:none}
 .titleblock{grid-template-columns:repeat(2,minmax(0,1fr))}
 .titleblock div:nth-child(3){border-left:0}
 .titleblock div:nth-child(n+3){border-top:1px solid var(--hero-line)}
}
@media(max-width:680px){
 .services li{grid-template-columns:minmax(0,1fr)}
 .services li::after{display:none}
 .projects{grid-template-columns:minmax(0,1fr)}
}
@media(max-width:560px){
 .cta-row .btn{width:100%}
 .row2{grid-template-columns:minmax(0,1fr)}
}
@media(max-width:520px){
 .steps{grid-template-columns:minmax(0,1fr)}
 .steps li{border-bottom:1px solid var(--line);padding-bottom:1.1rem}
}
@media(max-width:480px){
 .facts{grid-template-columns:minmax(0,1fr)}
 .facts>div{border-bottom:1px solid var(--line);padding-bottom:.9rem}
 .brand .sub{display:none}
}

/* ============================================================
   14  REDUCED MOTION  (Teil 3, Abschnitt 16)
   ============================================================ */
@media(prefers-reduced-motion:reduce){
 html{scroll-behavior:auto}
 *,*::before,*::after{transition-duration:.01ms!important;transition-delay:0s!important;animation:none!important}
 .js .reveal{opacity:1;transform:none}
}

@media print{
 body{padding:0;color:#000;background:#fff}
 .site-header,.hero::before,.glow::before,.blueprint,.totop,.lang,.progress{display:none!important}
 .dark{background:#fff!important;color:#000!important;--fg:#000;--strong:#000;--muted:#333;--line:#999;--accent-text:#000}
 .sheet{padding-block:1.5rem;break-inside:avoid}
}

/* ============================================================
   15  ERGAENZUNGEN  (Fotos im Portfolio, Referenzliste)
   ============================================================ */
.drawing img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .9s var(--ease)}
