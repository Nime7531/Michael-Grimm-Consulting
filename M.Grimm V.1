.reflist li b{display:inline-block;min-width:5.5rem;font-weight:500;color:var(--accent-text);font-variant-numeric:tabular-nums}
.reflist li span{display:block;color:var(--muted);font-size:.82rem}
@media(max-width:680px){.reflist{columns:1}}
</style>
